(ns cli-skeleton.core.adder)

;; CORE layer: pure logic. Marked `:export true` so PHP can call it via the
;; auto-generated wrapper in src/PhelGenerated/ (run `composer export`).

(defn adder
  "Sum every numeric argument. Pure."
  {:export true}
  [& numbers]
  (apply + numbers))

(defn parse-int
  "Parse a string as a strict integer. Returns nil for anything else:
  floats, text, empty input, or a value outside the PHP integer range. Pure."
  ;; Not `parse-long`: it clamps an out-of-range value to the maximum integer.
  [s]
  (php/filter_var s php/FILTER_VALIDATE_INT php/FILTER_NULL_ON_FAILURE))

(defn sum-tokens
  "Sum integer tokens. Returns {:total n}, {:invalid [token ...]} when any token
  is not an integer, or {:overflow true} when the sum leaves the integer range. Pure."
  [tokens]
  (let [parsed  (map parse-int tokens)
        invalid (filter some? (map (fn [token n] (when (nil? n) token)) tokens parsed))]
    (if (seq invalid)
      {:invalid (vec invalid)}
      (let [total (apply adder parsed)]
        (if (int? total)
          {:total total}
          {:overflow true})))))
